(* Smoke test for examples/Cat.m31: postulates a concrete
   category, functors, and a functor into Cat, exercises the
   wrappers, and exercises the local equality-checker
   installation pathway. *)

require Cat ;;
open Cat ;;

(* ---- A concrete category and a morphism ---- *)

rule C : cat ;;
rule a : obj C ;;
rule b : obj C ;;
rule k : obj C ;;
rule f : hom C a b ;;
rule g : hom C b k ;;

(* identity at a, inferred from a : obj C *)
id a ;;
(* expected: ⊢ id' C a : hom C a a *)

(* composition g * f = g ∘ f : hom C a k, all categories inferred *)
g * f ;;
(* expected: ⊢ comp' C a b k g f : hom C a k *)

(* identity threading through composition *)
f * (id a) ;;
(* expected: ⊢ comp' C a a b f (id' C a) : hom C a b *)

(* ---- Functors ---- *)

rule D : cat ;;
rule G : functor C D ;;

(* G's action on objects and morphisms *)
fobj G a ;;
(* expected: ⊢ fobj' C D G a : obj D *)

fmap G f ;;
(* expected: ⊢ fmap' C D G a b f : hom D (fobj' C D G a) (fobj' C D G b) *)

(* ---- A functor into Cat, Grothendieck objects ---- *)

rule F : functor C Cat ;;
rule x : obj (fobj' C Cat F a) ;;

(* A Groth-object (a, x). *)
let p = groth_obj a x ;;

(* Projections via the generic Σ wrappers. *)
fst p ;;
snd p ;;

(* fst' on the explicit pair' reduces to its first component
   via Σ_β₁. *)
let fst_pair_eq =
  eq.prove
    (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) (groth_obj a x)
     ≡ a : obj C by ??)
;;

(* Local installation of cat_simp lets the equality checker
   unfold cat_id Cat ≡ Id'. *)
let cat_id_unfold =
  with_rules cat_simp (fun () ->
    eq.prove (id' Cat C ≡ Id' C : hom Cat C C by ??))
;;

(* ---- Grothendieck morphisms ---- *)

rule b' : obj C ;;
rule f_C : hom C a b' ;;
rule x' : obj (fobj' C Cat F b') ;;
rule phi_test : hom (fobj' C Cat F b')
                    (fobj' (fobj' C Cat F a) (fobj' C Cat F b')
                           (fmap' C Cat F a b' f_C)
                           x)
                    x' ;;

(* A Groth-morphism (f_C, phi_test). *)
let m = groth_hom f_C phi_test ;;

fst m ;;
snd m ;;

(* ---- Projection functor ---- *)

Groth_proj C F ;;

fobj (Groth_proj C F) p ;;

(* ---- pair as operation ----

   pair takes its type-family from the ambient checking-mode
   boundary. The handler normalizes the boundary type through
   the global equality checker, so any type registered as
   equivalent to a Σ fires the wrapper. *)

(* Boundary already at Σ form: handler fires directly. *)
let p_via_pair_Σ =
  pair a x : Σ (obj C) ({d : obj C} obj (fobj' C Cat F d)) ;;

(* Boundary at obj (Groth C F): handler normalizes via
   Groth_obj_eq, then matches the Σ pattern. *)
let p_via_pair_Groth = pair a x : obj (Groth C F) ;;

