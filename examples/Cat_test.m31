(* Smoke test for examples/Cat.m31.

   Postulates a concrete category C, a functor G : C → D, a
   functor F : C → Cat, and exercises every AML wrapper plus
   the cat_simp local-installation pathway. Each step that
   needs to elaborate is followed by the expected display so
   a casual reader can use this file as a usage example. *)

require Cat ;;
open Cat ;;

(* ---- A concrete category and a morphism ---- *)

rule C : cat ;;
rule a : obj C ;;
rule b : obj C ;;
rule k : obj C ;;
rule f : hom C a b ;;
rule g : hom C b k ;;

(* identity at a, inferred from a : obj C *)
id a ;;
(* expected: ⊢ id' C a : hom C a a *)

(* composition g * f = g ∘ f : hom C a k, all categories inferred *)
g * f ;;
(* expected: ⊢ comp' C a b k g f : hom C a k *)

(* identity threading through composition *)
f * (id a) ;;
(* expected: ⊢ comp' C a a b f (id' C a) : hom C a b *)

(* ---- Functors ---- *)

rule D : cat ;;
rule G : functor C D ;;

(* G's action on objects and morphisms *)
fobj G a ;;
(* expected: ⊢ fobj' C D G a : obj D *)

fmap G f ;;
(* expected: ⊢ fmap' C D G a b f : hom D (fobj' C D G a) (fobj' C D G b) *)

(* ---- A functor into Cat, Grothendieck objects ---- *)

rule F : functor C Cat ;;
rule x : obj (fobj' C Cat F a) ;;

(* Build a Groth-object via groth_obj. C and F are inferred
   from x's type. The result is a Σ-pair under the hood. *)
let p = groth_obj a x ;;

(* Projections via the generic Σ wrappers. After Groth_obj_eq
   registers, obj (Groth C F) ≡ Σ ... so fst / snd apply. *)
fst p ;;
snd p ;;

(* ---- Σ_β₁ fires globally ---- *)

(* Since pair' / fst' are Σ's generic primitives and Σ_β₁ is
   globally registered, the projection of a Σ-pair reduces
   automatically — no instance install needed. *)
let fst_pair_eq =
  eq.prove
    (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) (groth_obj a x)
     ≡ a : obj C by ??)
;;

(* ---- with_rules cat_simp: fires the Tier-2 unfoldings ---- *)

let cat_id_unfold =
  with_rules cat_simp (fun () ->
    eq.prove (id' Cat C ≡ Id C : hom Cat C C by ??))
;;
(* expected: ⊢ id' Cat C ≡ Id C : hom Cat C C *)

(* ---- Grothendieck morphisms ---- *)

(* Build a concrete C-morphism and an F-action morphism *)
rule b' : obj C ;;
rule f_C : hom C a b' ;;
rule x' : obj (fobj' C Cat F b') ;;
rule phi_test : hom (fobj' C Cat F b') (F_transport C F a b' f_C x) x' ;;

(* Build a Groth-morphism via groth_hom; C, F, c, c', x, x'
   are all inferred from f_C and phi_test's types. *)
let m = groth_hom f_C phi_test ;;

(* Project via the generic Σ wrappers — Groth_hom_eq fires to
   identify hom (Groth C F) … … with the appropriate Σ. *)
fst m ;;
snd m ;;
