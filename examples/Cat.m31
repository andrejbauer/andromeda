(* Categories, functors, the category of categories, and the
   Grothendieck construction over a functor into Cat.

   SIZE WARNING: This file postulates Cat : cat — the category
   of categories belonging to itself as a category. That is the
   Type-in-Type situation, inconsistent at the metatheory level
   by the Hurkens / Girard paradox. The constructions built
   here remain mechanically valid in the term language;
   nothing in the intended development exploits the paradox.
   Stratifying with a Level type carrying small and large is a
   mechanical refactor deferred to a future iteration.

   Naming convention (from examples/baby_implicit.m31): the
   primitive rule with all premises explicit is named with a
   trailing prime (id', comp', fobj', fmap'). The unprimed
   name is an AML wrapper that uses base.type_of to infer the
   category arguments from the explicit ones. Composition has
   a special infix wrapper ( * ) for readability. *)

require eq ;;

(* Reflexivity. refl' is derived (not postulated) from
   congruence; refl infers the type from the term. *)
let refl' = derive (A type) (a : A) -> a ≡ a : A by (congruence a a) ;;

let refl a =
  match base.type_of a with
  | (?A type) -> refl' A a
  end
;;

(* Symmetry. The nucleus has reflexivity_type / reflexivity_term
   and symmetry_type / symmetry_term internally, but the AML
   level only sees reflexivity (via congruence X X) — not
   symmetry. Postulate it. Same shape as eq_type_sym /
   eq_term_sym in theories/judgemental_equality_*.m31. *)
rule sym_type (A type) (B type) (A ≡ B) : B ≡ A ;;
rule sym_term (A type) (a : A) (b : A) (a ≡ b : A) : b ≡ a : A ;;

(* ---- Dependent sums (inlined from theories/dependent_sum.m31) ----

   The Grothendieck construction below uses dependent pairs at
   both the object and morphism level. Rather than re-axiomatize
   them twice (and lose the linearized β-rules that the standard
   library provides), we inline a self-contained Σ-type theory
   here. Primitive names take the primed form (pair', fst',
   snd'); AML wrappers below provide the unprimed, base.type_of-
   inferring "baby-implicits" forms. *)

rule Σ (A type) ({x : A} B type) type ;;

rule pair' (A type) ({x : A} B type) (a : A) (b : B{a}) : Σ A B ;;

rule fst' (A type) ({x : A} B type) (s : Σ A B) : A ;;

rule snd' (A type) ({x : A} B type) (s : Σ A B) : B{fst' A B s} ;;

(* β-laws (linearized Σ_β₁-style: outer A, B + inner A', B' +
   equality witnesses) so they can register with eq.add_rule. *)
rule Σ_β₁ (A type) ({x : A} B type)
          (A' type) ({x : A'} B' type)
          (a : A') (b : B'{a})
          (A' ≡ A by ξ) ({x : A'} B'{x} ≡ B{convert x ξ} by ζ)
          :?
          (eq.add_locally (derive -> ξ) (fun () ->
           eq.add_locally (derive (x : A') -> ζ{x}) (fun () ->
           fst' A B (pair' A' B' a b) ≡ a : A by ?? ))) ;;
eq.add_rule Σ_β₁ ;;

rule Σ_β₂ (A type) ({x : A} B type)
          (A' type) ({x : A'} B' type)
          (a : A') (b : B'{a})
          (A' ≡ A by ξ) ({x : A'} B'{x} ≡ B{convert x ξ} by ζ)
          :?
          (eq.add_locally (derive -> ξ) (fun () ->
           eq.add_locally (derive (x : A') -> ζ{x}) (fun () ->
           snd' A B (pair' A' B' a b) ≡ b : B{a} by ?? ))) ;;
eq.add_rule Σ_β₂ ;;

(* Extensionality: two Σ-pairs with equal projections are equal. *)
rule Σ_ext (A type) ({x : A} B type) (s : Σ A B) (t : Σ A B)
  (fst' A B s ≡ fst' A B t : A by ξ)
  (convert (snd' A B s) (congruence B{fst' A B s} B{fst' A B t} ξ) ≡
   snd' A B t : B{fst' A B t} by ζ)
  : s ≡ t : Σ A B ;;
eq.add_rule Σ_ext ;;

(* AML wrappers for the Σ projections: A and the type-family B
   are inferred from s : Σ A B via base.type_of. After
   Groth_obj_eq registers, these also work on Groth-objects
   (whose type is judgementally equal to a Σ-type). *)
let fst s =
  match base.type_of s with
  | (Σ ?A ?B type) -> fst' A B s
  end
;;

let snd s =
  match base.type_of s with
  | (Σ ?A ?B type) -> snd' A B s
  end
;;

(* ---- Phase A: cat with accessors and laws ---- *)

rule cat type ;;

rule obj (C : cat) type ;;

rule hom (C : cat) (a : obj C) (b : obj C) type ;;

rule id' (C : cat) (a : obj C) : hom C a a ;;

rule comp' (C : cat)
           (a : obj C) (b : obj C) (c : obj C)
           (g : hom C b c) (f : hom C a b)
         : hom C a c ;;

rule id_left
  (C : cat) (a : obj C) (b : obj C) (f : hom C a b)
  : comp' C a b b (id' C b) f ≡ f : hom C a b ;;

rule id_right
  (C : cat) (a : obj C) (b : obj C) (f : hom C a b)
  : comp' C a a b f (id' C a) ≡ f : hom C a b ;;

rule assoc
  (C : cat)
  (a : obj C) (b : obj C) (c : obj C) (d : obj C)
  (h : hom C c d) (g : hom C b c) (f : hom C a b)
  : comp' C a b d (comp' C b c d h g) f
  ≡ comp' C a c d h (comp' C a b c g f)
  : hom C a d ;;

(* Implicit-argument wrappers for the cat vocabulary. *)
let id a =
  match base.type_of a with
  | (obj ?C type) -> id' C a
  end
;;

let ( * ) g f =
  match (base.type_of g, base.type_of f) with
  | ((hom ?C ?b ?c type), (hom _ ?a _ type)) ->
      comp' C a b c g f
  end
;;

(* ---- Phase B: functor, functoriality, identity functor, functor composition ---- *)

rule functor (C : cat) (D : cat) type ;;

rule fobj'
  (C : cat) (D : cat) (F : functor C D)
  (a : obj C)
  : obj D ;;

rule fmap'
  (C : cat) (D : cat) (F : functor C D)
  (a : obj C) (b : obj C)
  (f : hom C a b)
  : hom D (fobj' C D F a) (fobj' C D F b) ;;

rule fmap_id
  (C : cat) (D : cat) (F : functor C D)
  (a : obj C)
  : fmap' C D F a a (id' C a)
  ≡ id' D (fobj' C D F a)
  : hom D (fobj' C D F a) (fobj' C D F a) ;;

rule fmap_comp
  (C : cat) (D : cat) (F : functor C D)
  (a : obj C) (b : obj C) (c : obj C)
  (g : hom C b c) (f : hom C a b)
  : fmap' C D F a c (comp' C a b c g f)
  ≡ comp' D
        (fobj' C D F a)
        (fobj' C D F b)
        (fobj' C D F c)
        (fmap' C D F b c g)
        (fmap' C D F a b f)
  : hom D (fobj' C D F a) (fobj' C D F c) ;;

(* Identity functor and functor composition — type formers
   only. β-rules dropped per the linearity audit. *)

rule Id (C : cat) : functor C C ;;

rule Comp
  (C : cat) (D : cat) (E : cat)
  (G : functor D E) (F : functor C D)
  : functor C E ;;

(* Implicit-argument wrappers for functors. *)
let fobj F a =
  match base.type_of F with
  | (functor ?C ?D type) -> fobj' C D F a
  end
;;

let fmap F f =
  match (base.type_of F, base.type_of f) with
  | ((functor ?C ?D type), (hom _ ?a ?b type)) ->
      fmap' C D F a b f
  end
;;

(* ---- Phase C: Cat as a category ---- *)

rule Cat : cat ;;

(* Object-level identification: a Cat-object is just a category.
   Wrapped in `derive ->` because zero-premise rules auto-apply
   at use sites, returning a judgement instead of a derivation. *)
rule Cat_obj : obj Cat ≡ cat ;;
eq.add_rule (derive -> Cat_obj) ;;

(* Hom-level identification: morphisms between two Cat-objects
   are functors. Premises are typed at `obj Cat`, not `cat` —
   the equality-checker stores patterns with the args at their
   *post-coercion* type, so the rule's premise types must match
   what the matcher will see. *)
rule Cat_hom (X : obj Cat) (Y : obj Cat)
  : hom Cat X Y ≡ functor X Y ;;
eq.add_rule Cat_hom ;;

(* Identity and composition unfolding for Cat. Premises at
   `obj Cat` for the same matcher reason. *)
rule Cat_id (C : obj Cat)
  : id' Cat C ≡ Id C : hom Cat C C ;;

rule Cat_comp
  (X : obj Cat) (Y : obj Cat) (Z : obj Cat)
  (G : hom Cat Y Z) (F : hom Cat X Y)
  : comp' Cat X Y Z G F ≡ Comp X Y Z G F
  : hom Cat X Z ;;

(* ---- Phase D: Grothendieck construction (object level) ---- *)

(* The Grothendieck category: for C : cat and F : functor C Cat,
   the category Groth C F has pairs (c, x) as objects, where
   c : obj C and x is an object of the category F c. *)
rule Groth (C : cat) (F : functor C Cat) : cat ;;

(* Identify obj (Groth C F) with the dependent sum over (c : obj C)
   of obj (F c). Registered globally so the Σ machinery (pair',
   fst', snd', Σ_β₁, Σ_β₂, Σ_ext) applies to Groth-objects
   transparently. *)
rule Groth_obj_eq (C : cat) (F : functor C Cat)
  : obj (Groth C F)
  ≡ Σ (obj C) ({c : obj C} obj (fobj' C Cat F c)) ;;
eq.add_rule Groth_obj_eq ;;

(* Groth-specific object constructor: builds a Σ-pair at the
   Groth type-family. C and F are inferred from x's type. *)
let groth_obj c x =
  match base.type_of x with
  | (obj (fobj' ?C _ ?F _) type) ->
      pair' (obj C) ({d : obj C} obj (fobj' C Cat F d)) c x
  end
;;

(* ---- Phase E: simp lists and the with_rules combinator ---- *)

(* Install a list of rules into the equality checker for the
   duration of a thunk. Restores the checker state after. *)
let rec with_rules rs thunk =
  match rs with
  | [] -> thunk ()
  | ?r :: ?rs -> eq.add_locally r (fun () -> with_rules rs thunk)
  end
;;

(* Tier-2 — structural unfoldings useful for downstream
   reasoning but not in the global checker. *)
let cat_simp =
  [ Cat_id
  ; Cat_comp
  ] ;;

(* Tier-3 — reasoning steps: category laws, functoriality
   laws. Non-linear, can never go in the global checker. *)
let cat_laws =
  [ id_left
  ; id_right
  ; assoc
  ; fmap_id
  ; fmap_comp
  ] ;;

(* ---- Phase F: Grothendieck morphisms ---- *)

(* Helper: F-transport. Mathematically the same as
   `fobj' (Fc) (Fc') (fmap' F f) x`, but postulated as a
   primitive rather than inlined because the natural inlined
   form hits pathological elaboration times via repeated
   Cat_obj / Cat_hom firing at every nesting level. *)
rule F_transport
  (C : cat) (F : functor C Cat)
  (c : obj C) (c' : obj C)
  (f : hom C c c')
  (x : obj (fobj' C Cat F c))
  : obj (fobj' C Cat F c') ;;

(* Identify hom (Groth C F) p q with the dependent sum over
   (f : hom C (fst' p) (fst' q)) of the morphism in F(fst' q)
   from the F-transport of (snd' p) along f to (snd' q).
   Inlined verbatim; the type-family
     ({d : obj C} obj (fobj' C Cat F d))
   appears repeatedly. *)
rule Groth_hom_eq
  (C : cat) (F : functor C Cat)
  (p : obj (Groth C F)) (q : obj (Groth C F))
  : hom (Groth C F) p q
  ≡ Σ (hom C
          (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) p)
          (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) q))
       ({f : hom C
                (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) p)
                (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) q)}
        hom (fobj' C Cat F
                   (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) q))
            (F_transport C F
                (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) p)
                (fst' (obj C) ({d : obj C} obj (fobj' C Cat F d)) q)
                f
                (snd' (obj C) ({d : obj C} obj (fobj' C Cat F d)) p))
            (snd' (obj C) ({d : obj C} obj (fobj' C Cat F d)) q))
;;
eq.add_rule Groth_hom_eq ;;

(* Groth-specific morphism constructor: builds a Σ-pair at the
   morphism-level type-family. C, F, c, c', x, x' inferred from
   f and phi's types. *)
let groth_hom f phi =
  match (base.type_of f, base.type_of phi) with
  | ((hom ?C ?c ?c' type),
     (hom (fobj' _ Cat ?F _) (F_transport _ _ _ _ _ ?x) ?x' type)) ->
      pair' (hom C c c')
            ({g : hom C c c'}
             hom (fobj' C Cat F c')
                 (F_transport C F c c' g x)
                 x')
            f phi
  end
;;
